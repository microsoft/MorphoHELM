# MorphoHELM ignore rules

# Python/cache artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments and local secrets
.env
.env.*
!.env.example
.venv/
venv/
env/
ENV/
*.pem
*.key

# Editors and OS files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

# Logs and temporary outputs
logs/
*.log
tmp/
temp/
*.tmp

# Pipeline outputs that should be regenerated locally
results/
graphics/
aggregated/

# Raw/intermediate data products are intentionally not versioned.
# Curated benchmark inputs under data/main_paper_inputs, data/qc, and
# data/enrichment are tracked via Git LFS.
data/corrected_images/
data/huggingface/
data/metadata_cache/
data/bounding_boxes/
data/MorphoBenchFeaturesAggregated/
data/MorphoBenchFeaturesNormalized/
data/embeddings/

# Feature-extraction scratch outputs
feature-extraction/logs/
feature-extraction/test_logs*/
feature-extraction/test_output*/

# Notebook checkpoints
.ipynb_checkpoints/

# Paper
paper/